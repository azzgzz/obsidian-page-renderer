{
  "name": "page-md-renderer",
  "version": "1.0.0",
  "description": "Export notes, folders, and selected Markdown files to Markdown with rendered Dataview and Tasks query results.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "check:version": "node scripts/check-version.mjs",
    "lint:obsidian-warnings": "eslint 'src/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "export",
    "markdown",
    "dataview",
    "tasks"
  ],
  "author": "AzzGzz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/azzgzz/obsidian-page-renderer"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
